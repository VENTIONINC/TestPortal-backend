    },
    {
      "name": "🧹 Cleanup",
      "item": [
        {
          "name": "Clear MCP Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Clear session ID from environment",
                  "pm.environment.set('mcpSessionId', '');",
                  "console.log('MCP session ID cleared');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{V_1}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{V_1}}",
                "status"
              ]
            }
          }
        }
      ]
    }
  ]
}