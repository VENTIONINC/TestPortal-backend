{
  "info": {
    "name": "Issue API",
    "description": "Authenticated V2 Issue API and Assign Issue modal workflow. Issue categories are lowercase persisted values; Result feedback is used for Result and Dashboard analytics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "🔐 Setup Authentication",
      "item": [{
        "name": "User Login (Get Tokens)",
        "request": {
          "method": "POST",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "url": "{{baseUrl}}{{V_2}}/users/login",
          "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}" }
        },
        "event": [{
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login succeeds', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.environment.set('accessToken', body.accessToken);",
              "pm.environment.set('refreshToken', body.refreshToken);"
            ]
          }
        }]
      }]
    },
    {
      "name": "📋 Issues (Authenticated V2)",
      "item": [
        {
          "name": "Get All Issues (Persisted Category Filter)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}{{V_2}}/issues?projectId={{projectId}}&category=bug&page=1&limit=10"
          }
        },
        {
          "name": "Get All Issues with Stats",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}{{V_2}}/issues/with-stats?projectId={{projectId}}&statFrom=2026-08-01T00:00:00.000Z&statTo=2026-08-31T00:00:00.000Z"
          }
        },
        {
          "name": "Create Issue (Lowercase Category)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}{{V_2}}/issues",
            "body": { "mode": "raw", "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"name\": \"Authenticated API Test Issue\",\n  \"category\": \"bug\",\n  \"description\": \"Test issue created through the authenticated API\",\n  \"portal\": \"secure-portal\",\n  \"service\": \"auth-service\",\n  \"ticket\": \"SECURE-456\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Issue is created', function () { pm.response.to.have.status(201); });",
                "pm.environment.set('issueId', pm.response.json().id);"
              ]
            }
          }]
        },
        {
          "name": "Get Issue by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}{{V_2}}/issues/{{issueId}}?projectId={{projectId}}"
          }
        },
        {
          "name": "Update Issue Category",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}{{V_2}}/issues/{{issueId}}",
            "body": { "mode": "raw", "raw": "{\n  \"category\": \"infra\",\n  \"description\": \"Updated persisted Issue category\"\n}" }
          }
        }
      ]
    },
    {
      "name": "🧪 Validation and Authentication Checks",
      "item": [
        {
          "name": "Issue List Without Token (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}{{V_2}}/issues?projectId={{projectId}}"
          }
        },
        {
          "name": "Create Issue with Missing Category (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}{{V_2}}/issues",
            "body": { "mode": "raw", "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"name\": \"Invalid issue without category\"\n}" }
          }
        }
      ]
    },
    {
      "name": "🧩 Assign Issue Modal (Authenticated V2)",
      "item": [
        {
          "name": "Get Modal Context",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}{{V_2}}/result-errors/{{resultErrorId}}/modal-context?projectId={{projectId}}"
          }
        },
        {
          "name": "Create and Assign Confirmed Issue (Atomic)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}{{V_2}}/result-errors/{{resultErrorId}}/issue",
            "body": { "mode": "raw", "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"name\": \"New confirmed issue\",\n  \"category\": \"performance\",\n  \"description\": \"Creates the Issue, confirmed assumption, and Result feedback together\"\n}" }
          }
        },
        {
          "name": "Edit Confirmed Issue (Atomic)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}{{V_2}}/result-errors/{{resultErrorId}}/issue",
            "body": { "mode": "raw", "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"category\": \"script\",\n  \"description\": \"Synchronizes only this confirmed assignment's containing Result feedback\"\n}" }
          }
        }
      ]
    }
  ]
}
