{
  "info": {
    "name": "Report API",
    "description": "PDF export endpoint for dashboard analytics reports.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Export PDF Report",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"project\": \"{{projectName}}\",\n  \"executionType\": \"Nightly\",\n  \"periodStart\": \"2026-01-01\",\n  \"periodEnd\": \"2026-01-31\",\n  \"granularity\": \"daily\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}{{V_2}}/reports/pdf-export",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{V_2}}",
            "reports",
            "pdf-export"
          ]
        },
        "description": "Exports dashboard data across all execution environments as PDF. Response is binary application/pdf with Content-Disposition filename."
      },
      "response": []
    }
  ]
}
