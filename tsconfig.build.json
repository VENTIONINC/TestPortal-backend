{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "sourceMap": false,
    "declaration": false
  },
  "exclude": [
    "node_modules",
    "__tests__",
    "__prompts-tests__",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.d.ts"
  ],
  "tsc-alias": {
    "resolveFullPaths": true
  }
}
