# Core runtime
PORT=3001
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/test_portal?schema=public"
JWT_SECRET="change-me"

# Authentication mode
# Supported values: local, cognito
# local:
# - email/password auth is handled by this backend
# - startup bootstraps an admin user, so ADMIN_EMAIL (or ADMIN) and ADMIN_PASSWORD are required
# cognito:
# - login/signup flows are delegated to AWS Cognito
# - COGNITO_USER_POOL_ID, COGNITO_CLIENT_ID, and COGNITO_POOL_REGION are required
AUTH_PROVIDER=local

# Local auth bootstrap admin
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Cognito auth configuration
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""
COGNITO_POOL_REGION=""

# MCP and upload API token signing
MCP_SECRET="change-me"
API_KEY_SECRET="change-me"

# AI-powered analysis features
OPENAI_API_KEY=""

# Optional tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="test-portal-backend"

# Optional application defaults
DEFAULT_PROJECT_ID="b4225bdf-9e2b-43f9-8f13-5bb6f5079176"
TEST_USER_EMAIL="test@example.com"
TEST_USER_PASSWORD="testpassword123"

# Optional logging
LOG_LEVEL="info"
LOG_TO_FILE=false

# Optional PDF export overrides
PDF_EXPORT_LOGO_PATH=""
PDF_EXPORT_CHART_FONT_PATH=""
