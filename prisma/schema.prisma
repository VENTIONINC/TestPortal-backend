// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  pending
  active
  suspended
}

enum UserRole {
  admin
  member
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  categoryWeights Json?

  // Simple ownership
  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String @db.Uuid

  // Relationships
  executions    Execution[]
  specs         Spec[]
  issues        Issue[]
  uploadApiKeys UploadApiKey[]
  dailyMetrics  DailyExecutionMetric[]

  @@index([name])
  @@index([ownerId])
}

model Execution {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  type        String
  name        String
  environment String
  version     String // playwright version
  startedAt   DateTime
  provider    String   @default("Playwright")

  // Project relationship
  project   Project @relation(fields: [projectId], references: [id])
  projectId String  @db.Uuid

  results Result[]

  @@index([projectId])
  @@index([projectId, environment])
  @@index([projectId, type])
  @@index([projectId, startedAt])
}

model Spec {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  key         String // e.g. TestRail Id
  file        String
  title       String
  tags        Json     @default("[]")
  annotations Json     @default("[]")

  // Project relationship
  project   Project @relation(fields: [projectId], references: [id])
  projectId String  @db.Uuid

  results Result[]

  // Unique key per project
  @@unique([projectId, key])
  @@index([projectId])
  @@index([projectId, file])
  @@index([projectId, title])
}

model Result {
  id                              String        @id @default(uuid()) @db.Uuid
  createdAt                       DateTime      @default(now())
  updatedAt                       DateTime      @updatedAt
  reportPortalLink                String?
  retry                           Int
  status                          String
  duration                        Int
  startTime                       DateTime
  errors                          ResultError[]
  spec                            Spec          @relation(fields: [specId], references: [id])
  specId                          String        @db.Uuid
  execution                       Execution     @relation(fields: [executionId], references: [id])
  executionId                     String        @db.Uuid
  analysisStatus                  String? // "passed" | "failed"
  analysisCategory                String? // "bug" | "infra" | "performance" | "script" | "other"
  analysisConfidence              Int? // 1 to 5
  analysisConclusion              String? // Brief explanation for the categorization decision
  analysisErrorQuality            Int? // 1 to 5 (only for failed tests)
  analysisErrorQualityConclusion  String? // Brief explanation for error quality rating (only for failed tests)
  analysisReviewedAt              DateTime?
  analysisReviewedById            String? @db.Uuid
  analysisFeedbackCategory        String?
  analysisFeedbackConfidence      Int?
  analysisFeedbackConclusion      String?
}

model ResultError {
  id              String       @id @default(uuid()) @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  type            String
  message         String
  callLog         Json?
  callStack       Json
  testAssertion   String?
  expectedPattern String?
  receivedString  String?
  location        String
  result          Result?      @relation(fields: [resultId], references: [id])
  resultId        String?      @db.Uuid
  assumptions     Assumption[]
}

model Assumption {
  id            String       @id @default(uuid()) @db.Uuid
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  isConfirmed   Boolean
  score         Float
  madeBy        String
  issue         Issue        @relation(fields: [issueId], references: [id])
  issueId       String       @db.Uuid
  resultError   ResultError? @relation(fields: [resultErrorId], references: [id])
  resultErrorId String?      @db.Uuid
}

model User {
  id                      String   @id @default(uuid()) @db.Uuid
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  name                    String
  email                   String   @unique
  status                  UserStatus @default(active)
  role                    UserRole   @default(member)
  passwordHash            String?
  cognitoUserId           String?  @unique
  mcpToken                String?  @unique
  reportPortalUrl         String?
  reportPortalEnabled     Boolean  @default(false)
  monitoringPortalUrl     String?
  monitoringPortalEnabled Boolean  @default(false)
  analyzeEnabled          Boolean  @default(false)

  // Project relationships
  projects      Project[]
  issuesCreated Issue[]        @relation("IssuesCreated")
  issuesUpdated Issue[]        @relation("IssuesUpdated")
  uploadApiKeys UploadApiKey[]
}

model Issue {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String
  category    String
  description String?
  portal      String?
  service     String?
  ticket      String?

  // Project relationship
  project   Project @relation(fields: [projectId], references: [id])
  projectId String  @db.Uuid

  createdBy   User?   @relation("IssuesCreated", fields: [createdById], references: [id])
  createdById String? @db.Uuid
  updatedBy   User?   @relation("IssuesUpdated", fields: [updatedById], references: [id])
  updatedById String? @db.Uuid
  assumptions Assumption[]

  @@index([projectId])
  @@index([projectId, category])
  @@index([projectId, createdAt])
}

model UploadApiKey {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  apiKey    String   @unique
  isActive  Boolean  @default(true)

  // Project relationship
  project   Project @relation(fields: [projectId], references: [id])
  projectId String  @db.Uuid

  // Owner relationship
  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String @db.Uuid

  @@index([projectId])
  @@index([ownerId])
  @@index([apiKey])
}

model DailyExecutionMetric {
  id          String   @id @default(uuid()) @db.Uuid
  date        DateTime @db.Date
  projectId   String   @db.Uuid
  environment String
  type        String

  // Stats
  totalTests    Int @default(0)
  passedTests   Int @default(0)
  failedTests   Int @default(0)
  skippedTests  Int @default(0)
  timedOutTests Int @default(0)
  totalDuration Int @default(0)

  // Issues
  issuesBug         Int @default(0)
  issuesEnvironment Int @default(0)
  issuesScript      Int @default(0)
  issuesPerformance Int @default(0)
  issuesOther       Int @default(0)

  project Project @relation(fields: [projectId], references: [id])

  @@unique([projectId, environment, type, date])
  @@index([projectId, date])
}
