// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model Execution {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  type        String
  name        String
  environment String
  version     String // playwright version
  startedAt   DateTime
  results     Result[]
}

model Spec {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  key         String   @unique // e.g. TestRail Id
  file        String
  title       String
  tags        String
  annotations String?
  results     Result[]
}

model Result {
  id                 Int           @id @default(autoincrement())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  allureLink         String?
  retry              Int
  status             String
  duration           Int
  startTime          DateTime
  errors             ResultError[]
  spec               Spec          @relation(fields: [specId], references: [id])
  specId             Int
  execution          Execution     @relation(fields: [executionId], references: [id])
  executionId        Int
  analysisStatus     String?       // "passed" | "failed"
  analysisCategory   String?       // "bug" | "infra" | "performance" | "script" | "other"
  analysisConfidence Float?        // 0.0 to 1.0
  analysisConclusion String?       // Brief explanation for the categorization decision
}

model ResultError {
  id              Int          @id @default(autoincrement())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  type            String
  message         String
  callLog         String?
  callStack       String
  testAssertion   String?
  expectedPattern String?
  receivedString  String?
  location        String
  result          Result?      @relation(fields: [resultId], references: [id])
  resultId        Int?
  assumptions     Assumption[]
}

model Assumption {
  id            Int          @id @default(autoincrement())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  isConfirmed   Boolean
  score         Float
  madeBy        String
  issue         Issue        @relation(fields: [issueId], references: [id])
  issueId       Int
  resultError   ResultError? @relation(fields: [resultErrorId], references: [id])
  resultErrorId Int?
}

model User {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  name          String
  email         String   @unique
  passwordHash  String?
  cognitoUserId String?  @unique
  mcpToken      String?  @unique
  apiKey        String?  @unique
  issuesCreated Issue[]  @relation("IssuesCreated")
  issuesUpdated Issue[]  @relation("IssuesUpdated")
}

model Issue {
  id          Int          @id @default(autoincrement())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  name        String
  category    String
  description String?
  portal      String?
  service     String?
  ticket      String?
  createdBy   User?        @relation("IssuesCreated", fields: [createdById], references: [id])
  createdById Int?
  updatedBy   User?        @relation("IssuesUpdated", fields: [updatedById], references: [id])
  updatedById Int?
  assumptions Assumption[]
}
