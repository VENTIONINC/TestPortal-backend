# Service Layer Patterns

## Overview
Service layer handles business logic, validation, and orchestration between controllers and models. Services should be pure business logic without HTTP concerns.

## Basic Service Structure

### Standard Service Pattern
```typescript
import { domainModel } from "@/models/domainModel";
import type { PrismaDomain } from "@/types";

interface GetAllParams {
  filter1?: string;
  filter2?: string;
  page?: number;
  limit?: number;
}

interface GetAllResponse {
  items: PrismaDomain[];
  total: number;
  page: number;
  totalPages: number;
}

interface CreateParams {
  name: string;
  category: string;
  description?: string;
}

interface UpdateParams {
  name?: string;
  category?: string;
  description?: string;
}

export const domainService = {
  // List/Search with pagination
  async getAll(params: GetAllParams): Promise<GetAllResponse> {
    const { filter1, filter2, page = 1, limit = 30 } = params;
    
    // Input validation with TypeScript
    const validatedPage = Number(page);
    const validatedLimit = Number(limit);
    
    if (isNaN(validatedPage) || validatedPage < 1) {
      throw new Error("Page must be a positive number");
    }
    
    if (isNaN(validatedLimit) || validatedLimit < 1 || validatedLimit > 1000) {
      throw new Error("Limit must be between 1 and 1000");
    }
    
    // Business logic - data retrieval
    const items = await domainModel.findMany(filter1, filter2, validatedPage, validatedLimit);
    const totalItems = await domainModel.count(filter1, filter2);

    // Business logic - response structure
    return {
      items,
      total: totalItems,
      page: validatedPage,
      totalPages: Math.ceil(totalItems / validatedLimit),
    };
  },

  // Get by ID with validation
  async getById(itemId: number | string): Promise<PrismaDomain> {
    if (!itemId) {
      throw new Error("Item ID is required");
    }

    const item = await domainModel.findById(itemId);

    if (!item) {
      throw new Error(`Item with ID ${itemId} not found`);
    }

    return item;
  },

  // Create with validation
  async create(itemData: CreateParams): Promise<PrismaDomain> {
    // Business validation
    if (!itemData || !itemData.name) {
      throw new Error("Unable to create item without required fields");
    }

    // Additional business rules with type safety
    if (itemData.name.length < 3) {
      throw new Error("Item name must be at least 3 characters");
    }

    const createdItem = await domainModel.create(itemData);
    return createdItem;
  },

  // Update with validation and data cleaning
  async update(itemId: number | string, updateData: UpdateParams): Promise<PrismaDomain> {
    if (!itemId) {
      throw new Error("Item ID is required");
    }

    // Business logic - clean and validate update data with TypeScript
    const { name, category, description } = updateData;
    
    const cleanUpdateData: Partial<CreateParams> = {};
    if (name) cleanUpdateData.name = name;
    if (category) cleanUpdateData.category = category;
    if (description !== undefined) cleanUpdateData.description = description;

    // Remove undefined values if needed
    Object.keys(cleanUpdateData).forEach(key => 
      cleanUpdateData[key as keyof CreateParams] === undefined && 
      delete cleanUpdateData[key as keyof CreateParams]
    );

    const updatedItem = await domainModel.update(itemId, cleanUpdateData);
    return updatedItem;
  },
};
```

## TypeScript Interface Patterns

### Service Method Interfaces
```typescript
// Input parameters interface
interface GetItemsParams {
  category?: string;
  status?: string;
  page?: number;
  limit?: number;
}

// Response data interface  
interface GetItemsResponse {
  items: PrismaItem[];
  total: number;
  page: number;
  totalPages: number;
}

// Service method with proper typing
async getItems(params: GetItemsParams): Promise<GetItemsResponse> {
  // Implementation
}
```

### CRUD Operation Interfaces
```typescript
// Create operation
interface CreateItemParams {
  name: string;              // Required
  category: string;          // Required
  description?: string;      // Optional
  metadata?: object;         // Optional
}

// Update operation
interface UpdateItemParams {
  name?: string;             // All optional for updates
  category?: string;
  description?: string;
  metadata?: object;
}

// Service methods
async createItem(params: CreateItemParams): Promise<PrismaItem> { }
async updateItem(id: number | string, params: UpdateItemParams): Promise<PrismaItem> { }
```

## Input Validation Patterns

### Required Field Validation
```typescript
async create(itemData: CreateParams): Promise<PrismaDomain> {
  if (!itemData || !itemData.name) {
    throw new Error("Unable to create item without name");
  }
  
  // Additional required field checks with type safety
  if (!itemData.category) {
    throw new Error("Category is required");
  }
  
  // Type-safe length validation
  if (itemData.name.length < 3) {
    throw new Error("Name must be at least 3 characters");
  }
}
```

### ID Validation
```typescript
async getById(itemId: number | string): Promise<PrismaDomain> {
  if (!itemId) {
    throw new Error("Item ID is required");
  }
  
  // Type conversion with validation
  const numericId = Number(itemId);
  if (isNaN(numericId) || numericId <= 0) {
    throw new Error("Invalid item ID format - must be a positive number");
  }
}
```

### Data Type Validation
```typescript
async getAll(params: GetAllParams): Promise<GetAllResponse> {
  const { page = 1, limit = 30 } = params;
  
  const validatedPage = Number(page);
  const validatedLimit = Number(limit);
  
  if (isNaN(validatedPage) || validatedPage < 1) {
    throw new Error("Page must be a positive number");
  }
  
  if (isNaN(validatedLimit) || validatedLimit < 1 || validatedLimit > 1000) {
    throw new Error("Limit must be between 1 and 1000");
  }
}
```

## Error Handling Standards

### Meaningful Error Messages
```typescript
// ✅ GOOD - Specific, actionable error messages
throw new Error("Issue ID is required");
throw new Error(`Issue with ID ${issueId} not found`);
throw new Error("Unable to create issue without name");

// ❌ BAD - Generic, unhelpful errors
throw new Error("Error occurred");
throw new Error("Invalid input");
```

### Business Rule Errors
```typescript
async create(issueData: CreateIssueParams): Promise<PrismaIssue> {
  if (issueData.priority === 'critical' && !issueData.assignee) {
    throw new Error("Critical issues must have an assignee");
  }
  
  // Type-safe enum validation
  const validPriorities = ['low', 'medium', 'high', 'critical'] as const;
  if (!validPriorities.includes(issueData.priority)) {
    throw new Error(`Priority must be one of: ${validPriorities.join(', ')}`);
  }
}
```

### Error Context with TypeScript
```typescript
async processData(data: ProcessParams): Promise<ProcessResult> {
  try {
    // Business logic here
    return result;
  } catch (error) {
    // Re-throw with context while preserving type
    throw new Error(`Failed to process data: ${(error as Error).message}`);
  }
}
```

## Data Processing Patterns

### Safe Data Transformation
```typescript
interface RawData {
  id: number;
  name: string;
  metadata?: string; // JSON string
}

interface ProcessedData {
  id: number;
  name: string;
  metadata?: object; // Parsed object
}

async processItems(items: RawData[]): Promise<ProcessedData[]> {
  return items.map(item => ({
    id: item.id,
    name: item.name,
    metadata: item.metadata ? this.safeJsonParse(item.metadata) : undefined,
  }));
}

private safeJsonParse(jsonString: string): object | undefined {
  try {
    return JSON.parse(jsonString);
  } catch {
    return undefined; // Return undefined for invalid JSON
  }
}
```

### Pagination Logic
```typescript
interface PaginationParams {
  page: number;
  limit: number;
}

interface PaginatedResponse<T> {
  items: T[];
  total: number;
  page: number;
  totalPages: number;
  hasNext: boolean;
  hasPrev: boolean;
}

async getPaginated<T>(
  fetchItems: (page: number, limit: number) => Promise<T[]>,
  countItems: () => Promise<number>,
  params: PaginationParams
): Promise<PaginatedResponse<T>> {
  const { page, limit } = params;
  
  const [items, total] = await Promise.all([
    fetchItems(page, limit),
    countItems()
  ]);
  
  const totalPages = Math.ceil(total / limit);
  
  return {
    items,
    total,
    page,
    totalPages,
    hasNext: page < totalPages,
    hasPrev: page > 1,
  };
}
```

