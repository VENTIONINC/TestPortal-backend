  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "dev": "nodemon --exec tsx index.ts",
    "headers:add": "node scripts/add-license-headers.js",
    "new:file": "node scripts/new-file.js",
    "server": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed": "node prisma/seed/index.js",
    "seed:migrate": "node prisma/seed/migrate-from-sqlite.js",
    "db:generate": "prisma generate",
    "studio": "npx prisma studio",
    "migrate": "npx prisma migrate dev --name commit",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js",
    "test": "jest --config jest.config.ts"
  },
